    "rng = np.random.default_rng()\n",
    "\n",
    "tabla_array = 100*rng.random((10, 4))\n",
    "encabezados = [\"T\", \"P\", \"u\", \"s\"]\n",
    "unidades = {\"T\": \"K\", \"P\": \"kPa\", \"u\": \"kJ/kg\", \"s\":\"kJ/kg*K\"}\n",
    "\n",
    "tabla = PropData(datos=tabla_array, encabezados=encabezados, unidades=unidades)\n",
    "\n",
    "print(tabla)"
   ]
